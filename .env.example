# Copy values to your environment; no implicit .env loading.
PRIVANET_ADMIN_SECRET=replace-with-64-random-hex-characters
PRIVANET_HOST=127.0.0.1
PRIVANET_PORT=4010
PRIVANET_DATA_DIR=./var/coordinator
PRIVANET_STALE_MS=15000
PRIVANET_OFFLINE_MS=60000
PRIVANET_LEASE_MS=10000
PRIVANET_MAX_ATTEMPTS=3
PRIVANET_MAX_RELEASES=20
PRIVANET_SESSION_MS=300000
PRIVANET_MAINTENANCE_MS=1000
# Longest a single lease may be kept alive by renewals (ms).
PRIVANET_MAX_LEASE_MS=3600000
# Per-application queued+leased job limit (429 QUEUE_LIMIT beyond it).
PRIVANET_MAX_PENDING_PER_APP=10000
# Finished jobs are deleted after this long (ms); 0 keeps them forever.
PRIVANET_RETENTION_MS=2592000000
# Per-address authentication attempts per minute (see docs/deployment.md behind a proxy).
PRIVANET_AUTH_REQUESTS_PER_MINUTE=120
# For remote deployment, require a TLS reverse proxy with no direct listener access.
PRIVANET_TLS_TERMINATED=false
PRIVANODE_COORDINATOR_URL=http://127.0.0.1:4010
PRIVANODE_ALLOW_INSECURE_LOOPBACK=true
PRIVANODE_STATE_DIR=./var/node
# Empty by default: operator must enable each capability.
PRIVANODE_CAPABILITIES=system.echo.v1
PRIVANODE_HEARTBEAT_MS=5000
# Idle poll interval. After a finished job the node polls again at once; it waits this long only when the queue is empty.
PRIVANODE_POLL_MS=1000
# How long an idle lease request may wait at the Coordinator for work (0 = plain polling; at most 8000, and never more than the heartbeat interval).
PRIVANODE_LEASE_WAIT_MS=5000
# Concurrent jobs one node runs (1 to 64). Running jobs are counted against your memory, CPU, disk and network limits, so more slots never exceed them.
PRIVANODE_JOB_SLOTS=1
# Optional owner resource policy (strict JSON, see docs/development.md); omit for conservative defaults.
# PRIVANODE_POLICY_FILE=./var/node-policy.json
PRIVANODE_DRAIN_TIMEOUT_MS=30000
PRIVANODE_ENROLLMENT_TOKEN=deliver-once-through-private-environment
PRIVANET_APP_TOKEN=application-token-returned-once-by-admin

# Optional alpha.3 direct TLS chunk transfer. Capacity AND listener are independent opt-ins.
# Configure storage.enabled in your policy first. Defaults open no transfer listener.
# PRIVANODE_TRANSFER_ENABLED=false
# PRIVANODE_TRANSFER_BIND=127.0.0.1
# PRIVANODE_TRANSFER_PORT=4050
# PRIVANODE_TRANSFER_ENDPOINT=https://127.0.0.1:4050
# PRIVANODE_TRANSFER_CERT_FILE=/absolute/path/node.crt
# PRIVANODE_TRANSFER_KEY_FILE=/absolute/path/node.key
# PRIVANODE_TRANSFER_CONCURRENCY=8
# PRIVANODE_TRANSFER_PUTS=2

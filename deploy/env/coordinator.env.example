# /etc/privanet/coordinator.env  (owner root, mode 0600). Every name below is read by the Coordinator; nothing else is.
# Generate the secret once and keep a copy in your password manager: openssl rand -hex 32
PRIVANET_ADMIN_SECRET=
# Listen on the loopback only; Caddy (deploy/caddy/Caddyfile) is the only thing that talks to it from the LAN.
PRIVANET_HOST=127.0.0.1
PRIVANET_PORT=4010
PRIVANET_DATA_DIR=/var/lib/privanet/coordinator
# A crashed node's job is retried after this long (nodes renew the lease while healthy, so a longer lease costs nothing then).
PRIVANET_LEASE_MS=30000
# How long finished jobs and results are kept (30 days); keep it longer than your applications' retry window.
PRIVANET_RETENTION_MS=2592000000

# Set to true only when a reverse proxy on this machine (for example Caddy) appends the client address to X-Forwarded-For: the authentication
# rate limit is then applied per client instead of to the proxy as a whole. Off by default; see docs/deployment.md.
#PRIVANET_TRUST_LOOPBACK_PROXY=false

# /etc/privanet/node.env  (owner root, mode 0600). Every name below is read by the PrivaNode.
PRIVANODE_COORDINATOR_URL=https://10.0.0.68
# Trust the Coordinator's local CA (copy root.crt from the server; see docs/FIRST_DEPLOYMENT.md). Not needed if the CA is in the system store.
NODE_EXTRA_CA_CERTS=/etc/privanet/privanet-root.crt
PRIVANODE_STATE_DIR=/var/lib/privanet-node
PRIVANODE_CAPABILITIES=web.fetch.v1
PRIVANODE_POLICY_FILE=/etc/privanet/node-policy.json
# Concurrent jobs in one process, all inside the policy's limits. Start at 1 and raise it only if the node sits idle while work waits.
PRIVANODE_JOB_SLOTS=1
# Only for the first start: a one-time enrollment token from `admin enrollment`. Remove this line after the node has enrolled.
PRIVANODE_ENROLLMENT_TOKEN=

# /etc/privanet/node.env  (owner root, mode 0600). Every name below is read by the PrivaNode.
PRIVANODE_COORDINATOR_URL=https://10.0.0.68
# Trust the Coordinator's local CA (copy root.crt from the server; see docs/FIRST_DEPLOYMENT.md). Not needed if the CA is in the system store.
NODE_EXTRA_CA_CERTS=/etc/privanet/privanet-root.crt
PRIVANODE_STATE_DIR=/var/lib/privanet-node
PRIVANODE_CAPABILITIES=web.fetch.v1
PRIVANODE_POLICY_FILE=/etc/privanet/node-policy.json
# Concurrent jobs in one process, all inside the policy's limits. Start at 1 and raise it only if the node sits idle while work waits.
PRIVANODE_JOB_SLOTS=1
# Only for the first start: a one-time enrollment token from `privanet-admin enrollment create`. Remove this line after the node has enrolled.
# Alternative with no token in this file: run `privanet-node enroll --coordinator URL --token-file FILE` once (docs/ONBOARDING.md); the node then remembers the Coordinator and needs neither this line nor PRIVANODE_COORDINATOR_URL.
PRIVANODE_ENROLLMENT_TOKEN=

# Optional alpha.3 direct TLS chunk transfer. Capacity AND listener are independent opt-ins.
# Configure storage.enabled in your policy first. Defaults open no transfer listener.
# PRIVANODE_TRANSFER_ENABLED=false
# PRIVANODE_TRANSFER_BIND=127.0.0.1
# PRIVANODE_TRANSFER_PORT=4050
# PRIVANODE_TRANSFER_ENDPOINT=https://127.0.0.1:4050
# PRIVANODE_TRANSFER_CERT_FILE=/absolute/path/node.crt
# PRIVANODE_TRANSFER_KEY_FILE=/absolute/path/node.key
# PRIVANODE_TRANSFER_CONCURRENCY=8
# PRIVANODE_TRANSFER_PUTS=2

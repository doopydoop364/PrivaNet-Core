#!/usr/bin/env python3

import json
import os
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

DASHBOARD_URL = os.environ.get(
    "PRIVANET_ROUNDUP_DASHBOARD_URL",
    "http://127.0.0.1:4030",
).rstrip("/")
HOST = os.environ.get("PRIVANET_ROUNDUP_HOST", "127.0.0.1")
PORT = int(os.environ.get("PRIVANET_ROUNDUP_PORT", "4040"))
TIMEOUT = float(os.environ.get("PRIVANET_ROUNDUP_TIMEOUT", "10"))
DETAIL_LIMIT = max(1, min(int(os.environ.get("PRIVANET_ROUNDUP_DETAIL_LIMIT", "250")), 250))


def now():
    return datetime.now(timezone.utc).isoformat()


def get_json(path, query=None):
    url = DASHBOARD_URL + path
    if query:
        url += "?" + urllib.parse.urlencode(query)
    request = urllib.request.Request(
        url,
        headers={"Accept": "application/json", "User-Agent": "PrivaNet-Status/1.0"},
    )
    with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
        return json.loads(response.read().decode("utf-8"))


def details(kind, limit=DETAIL_LIMIT):
    return get_json(
        "/api/details",
        {"kind": kind, "offset": 0, "limit": min(limit, DETAIL_LIMIT)},
    )


def number(value):
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


def core_version():
    """Deployed Core release: the package.json beside bin/ in the release the /opt/privanet link points at (or None)."""
    try:
        value = json.loads((Path(__file__).resolve().parent.parent / "package.json").read_text()).get("version")
        return value if isinstance(value, str) and len(value) <= 64 else None
    except (OSError, ValueError, AttributeError):
        return None


def ratio(part, whole):
    return part / whole if whole else None


def by_queue(rows):
    return {str(row.get("queue")): row for row in rows or [] if isinstance(row, dict)}


def build_summary(generated_at, source_status, status, operational, concentration):
    """Compact, monitoring-oriented view derived ONLY from fields PrivaSearch already maintains (O(1) counters or its
    cached /status sections). Nothing is recounted here; a missing source section yields null, never a guess."""
    source_status = source_status or {}
    operational = operational if isinstance(operational, dict) else None
    concentration = concentration if isinstance(concentration, dict) else None
    source_ms = source_status.get("generatedAtMs")
    summary = {
        "generated_at": generated_at,
        "source_generated_at_ms": source_ms,
        "source_age_sec": round((datetime.now(timezone.utc).timestamp() * 1000 - source_ms) / 1000, 1) if isinstance(source_ms, (int, float)) else None,
        "versions": {"core": core_version(), "privasearch": source_status.get("version"), "schema": source_status.get("schemaVersion")},
        "totals": {key: status[key] for key in ("pending", "done", "failed", "in_flight", "blocked")},
        "documents": {"total": status["documents"], "indexed": status["indexed"], "duplicates": status["duplicates"], "duplicate_rate": ratio(status["duplicates"], status["documents"])},
        "queues": None, "throughput": None, "failures": None, "retries": None, "zero_yield": None,
        "suppressed": None, "concentration": None, "search_quality": None,
    }
    if operational is None:
        return summary
    queues = by_queue(operational.get("queues"))
    summary["queues"] = {name: {
        "pending": number(row.get("pending")), "in_flight": number(row.get("inFlight")), "failed": number(row.get("failed")),
        "url_due": number(row.get("urlDue")), "retrying": number(row.get("retrying")), "oldest_pending_ms": number(row.get("oldestPendingMs")),
    } for name, row in queues.items()}
    rows = (operational.get("throughput") or {}).get("rows") or []
    summary["throughput"] = {
        "window": (operational.get("throughput") or {}).get("window"),
        "fetched": sum(number(row.get("fetched")) for row in rows), "answers": sum(number(row.get("answers")) for row in rows),
        "fetched_per_minute": sum(float(row.get("fetchedPerMinute") or 0) for row in rows),
        "by_queue": {str(row.get("queue")): {"fetched": number(row.get("fetched")), "answers": number(row.get("answers"))} for row in rows},
    }
    outcomes, errors = {}, {}
    for row in operational.get("outcomes") or []:
        n = number(row.get("n"))
        outcomes[str(row.get("outcome"))] = outcomes.get(str(row.get("outcome")), 0) + n
        if row.get("error"):
            key = "%s/%s" % (row.get("outcome"), row.get("error"))
            errors[key] = errors.get(key, 0) + n
    answered = sum(outcomes.values())
    summary["failures"] = {"since_ms": operational.get("metricsSinceMs"), "answers": answered, "fetched": outcomes.get("FETCHED", 0), "fetched_rate": ratio(outcomes.get("FETCHED", 0), answered),
                           "by_outcome": outcomes, "by_error": errors}
    summary["retries"] = {key: sum(number(row.get(field)) for row in queues.values()) for key, field in (
        ("pending_retrying", "retrying"), ("under_1h", "retryUnderHour"), ("1h_to_1d", "retryHourToDay"), ("over_1d", "retryOverDay"), ("age_unknown", "retryAgeUnknown"))}
    zero = operational.get("zeroYieldTotals") or {}
    low = operational.get("lowYieldTotals") or {}
    summary["zero_yield"] = {"domains": number(zero.get("domains")), "pending": number(zero.get("pending")), "pending_share": ratio(number(zero.get("pending")), status["pending"]),
                             "low_yield_domains": number(low.get("domains")), "low_yield_pending": number(low.get("pending")), "low_yield_pending_share": ratio(number(low.get("pending")), status["pending"])}
    suppressed = operational.get("suppressed")
    summary["suppressed"] = {"cooldown_domains": number(suppressed.get("cooldownDomains")), "cooldown_pending": number(suppressed.get("cooldownPending")), "backed_off_hosts": number(suppressed.get("backedOffHosts"))} if isinstance(suppressed, dict) else None
    quality = operational.get("quality") or {}
    fetched = number(quality.get("fetched"))
    summary["search_quality"] = {"sampled_fetches": fetched, "useful": number(quality.get("useful")), "useful_rate": ratio(number(quality.get("useful")), fetched),
                                 "duplicate_rate": ratio(number(quality.get("duplicates")), fetched), "low_value_rate": ratio(number(quality.get("lowValue")), fetched), "error_rate": ratio(number(quality.get("errors")), fetched),
                                 "note": "Useful yield is an indexing proxy, not judged search relevance."}
    if concentration is not None:
        pending, families = concentration.get("pending") or {}, (concentration.get("families") or {}).get("pending") or {}
        summary["concentration"] = {"pending_top1": pending.get("top1"), "pending_top5": pending.get("top5"), "effective_domains": pending.get("effectiveDomains"),
                                    "family_top1": families.get("top1"), "effective_families": families.get("effectiveDomains"), "warnings": concentration.get("warnings") or []}
    return summary


def build_roundup():
    dashboard = get_json("/api/dashboard")
    source_status = dashboard.get("status") or {}
    documents = source_status.get("documents") or {}
    frontier = source_status.get("frontier") or {}
    meta = dashboard.get("meta") or {}

    status = {
        "documents": number(documents.get("documents")),
        "indexed": number(documents.get("indexed")),
        "duplicates": number(documents.get("duplicates")),
        "links": number(documents.get("links")),
        "hosts": number(frontier.get("hosts")),
        "pending": number(frontier.get("PENDING")),
        "in_flight": number(frontier.get("IN_FLIGHT")),
        "done": number(frontier.get("DONE")),
        "blocked": number(frontier.get("BLOCKED")),
        "failed": number(frontier.get("FAILED")),
        "pending_public": number(frontier.get("pendingPublic")),
        "pending_demand": number(frontier.get("pendingDemand")),
        "recrawls_due": number(frontier.get("recrawlDue")),
        "crawling": bool(source_status.get("crawling")),
        "uptime_sec": source_status.get("uptimeSec"),
    }

    health = {
        "data_age_sec": meta.get("ageSec"),
        "last_poll_ms": meta.get("lastPollMs"),
        "successful_polls": number(meta.get("successfulPolls")),
        "failed_polls": number(meta.get("failedPolls")),
        "dashboard_uptime_sec": number(meta.get("dashboardUptimeSec")),
        "last_success": meta.get("lastSuccess"),
        "last_error": meta.get("lastError"),
    }

    hosts_payload = details("hosts")
    hosts = hosts_payload.get("rows") or []
    domains = []
    sampled_urls = 0
    for row in hosts:
        total = sum(number(row.get(key)) for key in ("pending", "in_flight", "done", "blocked", "failed"))
        sampled_urls += total
        domains.append({
            "host": row.get("host"),
            "pending": number(row.get("pending")),
            "in_flight": number(row.get("in_flight")),
            "done": number(row.get("done")),
            "blocked": number(row.get("blocked")),
            "failed": number(row.get("failed")),
            "failures": number(row.get("failures")),
            "frontier_total": total,
        })
    domains.sort(key=lambda item: item["frontier_total"], reverse=True)

    recent_payload = details("documents", 100)
    failed_payload = details("failed", 100)

    duplicate_ratio = None
    if status["documents"]:
        duplicate_ratio = status["duplicates"] / status["documents"]

    failed_ratio = None
    if status["done"] + status["failed"]:
        failed_ratio = status["failed"] / (status["done"] + status["failed"])

    top_host_share = None
    if domains and sampled_urls:
        top_host_share = domains[0]["frontier_total"] / sampled_urls

    generated_at = now()
    return {
        "schema_version": 1,
        "generated_at": generated_at,
        "summary": build_summary(generated_at, source_status, status, frontier.get("operational"), frontier.get("concentration")),
        "status": status,
        "health": health,
        "quality": {
            "duplicate_ratio": duplicate_ratio,
            "failed_frontier_ratio": failed_ratio,
            "top_host_frontier_share": top_host_share,
            "host_share_note": "Sample-only; not a full-frontier concentration metric.",
            "concentration": frontier.get("concentration"),
            "operational": frontier.get("operational"),
            "source_generated_at_ms": source_status.get("generatedAtMs"),
        },
        "domains": {
            "total": hosts_payload.get("total"),
            "returned": len(domains),
            "rows": domains,
        },
        "recent": {
            "total": recent_payload.get("total"),
            "returned": len(recent_payload.get("rows") or []),
            "rows": recent_payload.get("rows") or [],
        },
        "errors": {
            "total": failed_payload.get("total"),
            "returned": len(failed_payload.get("rows") or []),
            "rows": failed_payload.get("rows") or [],
        },
    }


class Handler(BaseHTTPRequestHandler):
    def send_json(self, payload, status=200):
        body = json.dumps(payload, separators=(",", ":")).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path.rstrip("/") or "/"

        if path in {"/crawling/api/status", "/api/status", "/status"}:
            try:
                self.send_json(build_roundup())
            except Exception as error:
                self.send_json({"status": "degraded", "generated_at": now(), "error": str(error)}, 503)
            return

        if path == "/health":
            try:
                dashboard = get_json("/api/dashboard")
                healthy = bool(dashboard.get("status"))
                self.send_json({"status": "ok" if healthy else "degraded", "generated_at": now()}, 200 if healthy else 503)
            except Exception as error:
                self.send_json({"status": "degraded", "generated_at": now(), "error": str(error)}, 503)
            return

        self.send_json({"error": "not found"}, 404)

    def log_message(self, format, *args):
        pass


if __name__ == "__main__":
    print(f"PrivaNet crawler status API listening on http://{HOST}:{PORT}/crawling/api/status", flush=True)
    ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()
